  "components": {
    "schemas": {
      "Approval": {
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 5,
            "title": "Reason"
          },
          "evidence_checked": {
            "type": "boolean",
            "title": "Evidence Checked"
          },
          "ai_unavailable_ack": {
            "type": "boolean",
            "title": "Ai Unavailable Ack",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "reason",
          "evidence_checked"
        ],
        "title": "Approval"
      },
      "Draft": {
        "properties": {
          "region": {
            "type": "string",
            "title": "Region"
          }
        },
        "type": "object",
        "required": [
          "region"
        ],
        "title": "Draft"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Revision": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "sentences": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Sentences"
          },
          "reason": {
            "type": "string",
            "minLength": 5,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "title",
          "sentences",
          "reason"
        ],
        "title": "Revision"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
